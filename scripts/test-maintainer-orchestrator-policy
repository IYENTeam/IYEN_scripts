#!/usr/bin/env ruby
# frozen_string_literal: true

skill = File.read(File.expand_path("../skills/maintainer-orchestrator/SKILL.md", __dir__))
metadata = File.read(File.expand_path("../skills/maintainer-orchestrator/agents/openai.yaml", __dir__))

requirements = {
  "IYENTeam default scope" => "Treat `IYENTeam` as the default GitHub organization",
  "one repository lane" => "Use exactly one execution lane per repository",
  "root control plane" => "Keep root coordination, policy changes, and cross-repository decisions in the root session",
  "URL is read-only" => "A URL authorizes inspection, not mutation",
  "preserve unknown work" => "Never discard, overwrite, stash, reset, clean, or force-push unknown work",
  "triage is read-only" => "Triage is read-only unless the user also asks to act",
  "root cause before patch" => "Reproduce the behavior or establish the root cause",
  "exact-head CI" => "exact-head CI",
  "secret protection" => "Never print secrets or broadly dump environment variables",
  "explicit release authority" => "A release requires explicit user authorization",
  "Korean closeout" => "End with a concise Korean report",
  "remote verification" => "Never report success from a local patch alone when the requested outcome was remote",
}

missing = requirements.reject { |_label, text| skill.include?(text) }
abort "Missing maintainer-orchestrator policy: #{missing.keys.join(', ')}" unless missing.empty?

forbidden = ["steipete", "Peter", "OpenClaw", "ClawSweeper", "RepoBar"]
found = forbidden.select { |text| skill.match?(/#{Regexp.escape(text)}/i) }
abort "Personal upstream policy remains: #{found.join(', ')}" unless found.empty?

abort "Stale maintainer-orchestrator metadata" unless metadata.include?("IYENTeam") && metadata.include?("one execution lane per repository")

puts "Validated IYEN maintainer-orchestrator policy."
